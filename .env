# ══════════════════════════════════════════════════════════════════
# Liferay DXP Cluster — Environment Variables
# ══════════════════════════════════════════════════════════════════

# ── Image versions ────────────────────────────────────────────────
LIFERAY_IMAGE=liferay/dxp:2025.q1.6-lts
MYSQL_IMAGE=mysql:8.4
ES_IMAGE_TAG=8.19.0

# ── MySQL ─────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=lportal

# ── Elasticsearch ─────────────────────────────────────────────────
ES_CLUSTER_NAME=LiferayElasticsearchCluster
ES_JAVA_OPTS=-Xms1g -Xmx1g

# ── Liferay JVM ───────────────────────────────────────────────────
LIFERAY_JVM_OPTS=-Xms2g -Xmx4g -XX:+UseG1GC -XX:MaxGCPauseMillis=200 -Dfile.encoding=UTF-8 -Djava.net.preferIPv4Stack=true

# ── Liferay Node 1 ports ──────────────────────────────────────────
NODE1_HTTP_PORT=8080
NODE1_HTTPS_PORT=8443
NODE1_TOMCAT_SHUTDOWN_PORT=8005
NODE1_JGROUPS_PORT=7800
NODE1_OSGI_PORT=11311

# ── Liferay Node 2 ports ──────────────────────────────────────────
NODE2_HTTP_PORT=8081
NODE2_HTTPS_PORT=9443
NODE2_TOMCAT_SHUTDOWN_PORT=9005
NODE2_JGROUPS_PORT=7801
NODE2_OSGI_PORT=11312

# ── Elasticsearch Node 1 ports ────────────────────────────────────
ES1_HTTP_PORT=9200
ES1_TRANSPORT_PORT=9300

# ── Elasticsearch Node 2 ports ────────────────────────────────────
ES2_HTTP_PORT=9201
ES2_TRANSPORT_PORT=9301
