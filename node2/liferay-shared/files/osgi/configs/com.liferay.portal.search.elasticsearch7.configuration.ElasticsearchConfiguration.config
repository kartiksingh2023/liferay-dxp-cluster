# Liferay Elasticsearch 8 Connector — Node 2
# Primary: es-node2, failover: es-node1
# Static IPs are listed as fallback in case Docker DNS drops the hostname
# when a container is stopped (DNS failure → retry with next address).

operationMode="REMOTE"
productionModeEnabled=B"true"
clusterName="LiferayElasticsearchCluster"
networkHostAddresses=["es-node2:9200","172.28.1.2:9200","es-node1:9200","172.28.1.1:9200"]
authenticationEnabled=B"false"
httpSSLEnabled=B"false"
logExceptionsOnly=B"false"
